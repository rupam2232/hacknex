{
  "name": "rozi-agent",
  "version": "1.0.0",
  "type": "module",
  "description": "Real-time Bengali-first voice agent for daily-wage workers using LiveKit, Gemini, ElevenLabs, and MongoDB",
  "main": "src/index.ts",
  "scripts": {
    "seed": "tsx seed.ts",
    "dev": "tsx src/index.ts dev",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@livekit/agents": "^1.7.0",
    "@livekit/agents-plugin-deepgram": "^1.0.0",
    "@livekit/agents-plugin-elevenlabs": "^1.4.0",
    "@livekit/agents-plugin-google": "^1.5.0",
    "@livekit/agents-plugin-silero": "^1.9.0",
    "@livekit/plugins-ai-coustics": "^0.3.2",
    "@livekit/rtc-node": "^0.13.35",
    "dotenv": "^16.4.5",
    "mongoose": "^8.9.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
